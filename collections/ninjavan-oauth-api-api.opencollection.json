  "items": [
    {
      "info": {
        "name": "OAuth API",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Request access token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.ninjavan.co/{countryCode}/2.0/oauth/access_token",
            "body": {
              "type": "json",
              "data": "{}"
            }
