          "request": {
            "name": "Request access token",
            "description": {
              "content": "Exchanges a client ID and client secret for a short-lived OAuth2 access token using the client-credentials grant. Attach the returned token as a Bearer token on all subsequent requests.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "2.0",
                "oauth",
                "access_token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": " (This can only be one of sg,my,id,ph,vn,th)",
                  "type": "any",
                  "value": "{{countryCode}}",
                  "key": "countryCode"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_id\": \"<string>\",\n  \"client_secret\": \"<string>\",\n  \"grant_type\": \"client_credentials\"\n}",
